import asyncio
import re
import os
from telethon.sync import TelegramClient
import nest_asyncio

# برای هماهنگی با محیط گوگل کولب
nest_asyncio.apply()

# اطلاعات ورود به تلگرام
API_ID = xxxxx  # مقدار شما
API_HASH = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # مقدار شما
PHONE_NUMBER = "+xxxxxxxxxxxxx"  # شماره تلگرام شما (فقط در اولین اجرا نیاز است)

# لیست کانال‌هایی که می‌خوای بررسی کنی
CHANNELS = ["meli_proxyy", "mtmvpn"]

# الگوی Regex برای شناسایی لینک‌های پروکسی (لینک کامل)
PROXY_PATTERN = re.compile(r"(vmess://[a-zA-Z0-9+/=._-]+|vless://[a-zA-Z0-9@:/?&_=%.-]+#?[^ \n]*|trojan://[a-zA-Z0-9@:/?&_=%.-]+|ss://[a-zA-Z0-9@:/?&_=%.-]+)")

# حداکثر تعداد لینک‌هایی که ذخیره می‌شوند
MAX_PROXIES = 75

async def fetch_proxies():
    proxies = set()

    async with TelegramClient("session", API_ID, API_HASH) as client:
        for channel in CHANNELS:
            try:
                # دریافت 10 پیام آخر از هر کانال
                messages = await client.get_messages(channel, limit=2)

                for msg in messages:
                    if msg.text:
                        matches = PROXY_PATTERN.findall(msg.text)
                        for proxy in matches:
                            if len(proxies) < MAX_PROXIES:
                                proxies.add(proxy)
                            else:
                                break  # اگر به 50 لینک رسید، متوقف شود

            except Exception as e:
                print(f"خطا در خواندن {channel}: {e}")

    return proxies  # بازگرداندن لیست لینک‌ها

# اجرای کد و ذخیره نتیجه در متغیر `proxies`
proxies = asyncio.run(fetch_proxies())

# ذخیره فایل در گوگل درایو
from google.colab import drive

drive.mount('/content/drive')

# مسیر ذخیره در گوگل درایو
drive_path = "/content/drive/My Drive/V2Ray_Sub"
os.makedirs(drive_path, exist_ok=True)

file_path = os.path.join(drive_path, "sub.txt")
with open(file_path, "w", encoding="utf-8") as f:
    for proxy in proxies:
        f.write(proxy + "\n")

print(f"✅ فایل در گوگل درایو ذخیره شد: {file_path}")
